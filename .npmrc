# build-loop:dependency-cooldown (constitution C-SUPPLY) — don't install a package
# version until it's been public for the configured number of days. npm's native
# min-release-age has no scope-exclusion, so this also applies to own-scope
# packages. Pull a same-week bump of an own-scope package with a per-command
# override:  npm install --min-release-age=0 <pkg>
min-release-age=7
